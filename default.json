{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		":automergePatch",
		":automergeRequireAllStatusChecks",
		":rebaseStalePrs",
		":semanticCommitsDisabled",
		":separatePatchReleases",
		"config:recommended",
		"mergeConfidence:all-badges",
		"schedule:weekdays"
	],
	"description": [
		"This preset provides a solid base configuration for all projects developed at CPS GmbH.",
		"Consider using more specific presets in your projects since they might be better suited."
	],
	"commitBodyTable": true,
	"commitMessageLowerCase": "never",
	"commitMessagePrefix": "[TASK]",
	"commitMessageTopic": "{{depName}}",
	"composerIgnorePlatformReqs": null,
	"configMigration": true,
	"labels": [
		"dependencies"
	],
	"lockFileMaintenance": {
		"enabled": true,
		"commitMessageAction": "Update all dependencies"
	},
	"onboardingPrTitle": "[TASK] Configure Renovate",
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		{
			"matchDepTypes": [
				"devDependencies",
				"require-dev"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"automerge": true
		},
		{
			"groupName": "PHPStan",
			"matchPackageNames": [
				"phpstan/**"
			],
			"matchDepNames": [
				"jangregor/phpstan-prophecy",
				"saschaegerer/phpstan-typo3"
			]
		},
		{
			"extends": [
				":automergeDisabled"
			],
			"ignoreUnstable": false,
			"matchDepNames": [
				"php"
			],
			"rangeStrategy": "widen"
		},
		{
			"groupName": "GitHub artifact actions",
			"matchDepNames": [
				"actions/download-artifact",
				"actions/upload-artifact"
			]
		},
		{
			"groupName": "PHPUnit",
			"description": "Group PHPUnit packages",
			"matchDatasources": [
				"packagist"
			],
			"matchPackageNames": [
				"phpunit/**",
				"sebastian/**"
			]
		},
		{
			"groupName": "Rector",
			"description": "Group Rector packages",
			"matchDatasources": [
				"packagist"
			],
			"matchPackageNames": [
				"rector/**",
				"ssch/typo3-rector"
			]
		},
		{
			"groupName": "Guzzle",
			"description": "Group Guzzle packages",
			"matchDatasources": [
				"packagist"
			],
			"matchPackageNames": [
				"guzzlehttp/**"
			]
		},
		{
			"matchManagers": [
				"github-actions"
			],
			"pinDigests": true
		},
		{
			"matchDepNames": [
				"ramsey/composer-install"
			],
			"matchDepTypes": [
				"action"
			],
			"overrideDatasource": "github-digest"
		},
		{
			"matchDepNames": [
				"ghcr.io/l3montree-dev/devguard",
				"ghcr.io/l3montree-dev/devguard/scanner",
				"ghcr.io/l3montree-dev/devguard/vulndb/v1"
			],
			"changelogUrl": "https://github.com/l3montree-dev/devguard/blob/main/CHANGELOG.md",
			"sourceUrl": "https://github.com/l3montree-dev/devguard"
		},
		{
			"matchDepNames": [
				"ghcr.io/l3montree-dev/devguard-web"
			],
			"changelogUrl": "https://github.com/l3montree-dev/devguard-web/blob/main/CHANGELOG.md",
			"sourceUrl": "https://github.com/l3montree-dev/devguard-web"
		},
		{
			"matchDatasources": [
				"packagist"
			],
			"matchPackageNames": [
				"typo3/cms**",
				"typo3/theme-**",
				"!typo3/cms-base-distribution",
				"!typo3/cms-cli",
				"!typo3/cms-composer-installers"
			],
			"sourceUrl": "https://github.com/TYPO3/typo3"
		},
		{
			"matchDatasources": [
				"packagist"
			],
			"matchPackageNames": [
				"!cps/**",
				"!cpsit/**",
				"!fr/**"
			],
			"minimumReleaseAge": "3 days"
		}
	],
	"prConcurrentLimit": 10,
	"prHourlyLimit": 0,
	"vulnerabilityAlerts": {
		"commitMessagePrefix": "[SECURITY]",
		"commitMessageSuffix": ""
	}
}
